meta {
  name: Actualizar servicio
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/servicios/{{servicioId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "precio": 26000,
    "duracion": 30,
    "activo": true
  }
}
